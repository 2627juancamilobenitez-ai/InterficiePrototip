<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/preferences"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PreferencesActivity"
    android:padding="24dp">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/title_settings"
        android:textSize="28sp"
        android:gravity="center"/>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/darkThemeSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dark_theme"
        android:minHeight="48dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/notificacionsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notificacions"
        android:minHeight="48dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/font_size"
        android:textSize="16sp"
        android:layout_marginTop="16dp"/>

    <RadioGroup
        android:id="@+id/fontSizeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"
    >

        <RadioButton
            android:id="@+id/fontSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/font_small"
            android:minHeight="48dp"/>

        <RadioButton
            android:id="@+id/fontNormal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/font_normal"
            android:minHeight="48dp"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/fontLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/font_large"
            android:minHeight="48dp"/>
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:hint="@string/language"
        android:layout_marginTop="16dp">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/languageDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            app:simpleItems="@array/languages"
            android:text="@string/language_default"
            />

    </com.google.android.material.textfield.TextInputLayout>





</LinearLayout>